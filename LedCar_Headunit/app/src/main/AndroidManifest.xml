<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- In-app update checker (UpdateChecker/UpdateInstaller) - checks GitHub
         Releases and installs the downloaded APK directly, no Play Store. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Background automation keep-alive (LedCarBackgroundService, see
         TODO.md item 4): a foreground service so the BLE connection and
         CommandReceiver survive being backgrounded on a head unit.
         POST_NOTIFICATIONS is required to actually show the persistent
         notification a foreground service needs on API 33+; without it the
         service still runs, Android just silently drops the notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Broadcast Monitor (BroadcastMonitorService, MonitorConsoleActivity):
         a diagnostic tool, head-unit build only - floats a bubble that
         opens a live log of broadcast Intents this app can see, to help
         reverse-engineer what a head-unit's own launcher/OS (Junsun, or
         Agama) actually sends, before building a real integration against
         it. SYSTEM_ALERT_WINDOW is the "draw over other apps" permission
         the floating bubble needs; the service itself is foreground so it
         survives being backgrounded while you go poke around in another
         app to trigger something. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <!-- Locked to landscape (unlike the phone build, which is portrait-
         locked): head units are always landscape, and as of V1.002 there's
         a real purpose-built landscape layout (res/layout-land, the
         "Command Strip" arrangement) instead of just the phone's portrait
         layout rendered sideways - so there's no reason to ever show the
         portrait one on this build. -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.LedCar01Controller"
        android:supportsRtl="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.LedCar01Controller">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- TODO.md item 2: external automation entry point. Tasker's "Send
             Intent" action, Automate's "Send intent" block, and (via Tasker
             as a bridge) IFTTT can all target this receiver directly by
             package + class, without needing a full plugin SDK on either
             side - see CommandReceiver's class doc for the full extras
             contract. exported=true is required for another app's process
             to reach it at all; there's no dangerous capability behind it
             (LED color/brightness only), so no signature/custom permission
             is enforced on the sender. -->
        <receiver
            android:name=".CommandReceiver"
            android:exported="true" />

        <!-- TODO.md item 4: keeps BleDeviceManager's connection (and this
             receiver's ability to act on it) alive when the app isn't in
             the foreground - head units are often aggressive about killing
             backgrounded apps. connectedDevice is the closest match of the
             API 34 foreground-service types to "maintains a BLE link". -->
        <service
            android:name=".LedCarBackgroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Broadcast Monitor: floating bubble + background Intent logger.
             specialUse is the documented catch-all foreground-service type
             for cases (like an overlay bubble utility) that don't fit any
             of the more specific categories - the PROPERTY below is the
             short justification API 34 requires alongside it. -->
        <service
            android:name=".BroadcastMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating diagnostic bubble that logs broadcast Intents for reverse-engineering head-unit integrations" />
        </service>

        <!-- Its own task (taskAffinity distinct from the app's default,
             singleTask so re-tapping the bubble never stacks a second
             instance) - so the bubble's tap-to-open/tap-to-minimize toggle
             (see BroadcastMonitorService.openConsole()) only ever affects
             this console's own task, never MainActivity's. -->
        <activity
            android:name=".MonitorConsoleActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:launchMode="singleTask"
            android:taskAffinity="com.ledcar01.controller.monitor"
            android:theme="@style/Theme.LedCar01Controller" />
    </application>
</manifest>
