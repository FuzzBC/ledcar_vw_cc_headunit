<?xml version="1.0" encoding="utf-8"?>
<!--
     TODO.md item 3: dedicated head-unit landscape layout - "Command Strip"
     variant (see the design-review artifact this was picked from). Every
     view here keeps the exact same android:id as layout/activity_main.xml
     (the phone portrait layout) - MainActivity.bindViews() findViewById()s
     all of them with zero orientation-specific logic, so this file only
     needed to be a different *arrangement*, not a code change. Android
     picks this over the default layout/ automatically whenever the device
     is in landscape (head units almost always are; this repo leaves
     orientation unlocked - see AndroidManifest.xml).

     Everything you'd tap without thinking - settings, power, the zone pill,
     mode, scan/connect - lives in one persistent full-width strip at the
     top edge, the easiest reach zone on a dash-mounted screen. The body
     below is a left/right split: color-picking on the left, glanceable
     preview + brightness/speed on the right, each scrolling independently
     so a short, wide head-unit screen never clips the wheel or the saved-
     colors row.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_page">

    <!-- Command strip: every "reach it in one tap" control, full width. -->
    <LinearLayout
        android:id="@+id/topBarRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:background="@drawable/bg_pill_button"
            android:text="@string/settings_symbol"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <!-- Broadcast Monitor toggle - head-unit build only, see
             BroadcastMonitorService's class doc. Not present on the phone
             build (ledcar_vw_cc). -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnMonitor"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:background="@drawable/bg_pill_button"
            android:text="@string/monitor_symbol"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvDeviceSummary"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/no_device"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnPower"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:background="@drawable/bg_power_button"
            android:enabled="false" />

        <!-- Zone toggle: RGB left half / DMX right half, each showing that
             zone's own live color. Tap selects only that half; long-press
             selects both - marching border shows the current selection. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center">

            <FrameLayout
                android:id="@+id/zoneToggleContainer"
                android:layout_width="204dp"
                android:layout_height="56dp"
                android:padding="10dp"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnZoneRgb"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:text="@string/zone_rgb"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:shadowColor="#99000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="2" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnZoneDmx"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:text="@string/zone_dmx"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:shadowColor="#99000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="2" />
                </LinearLayout>

                <com.ledcar01.controller.MarchingAntsView
                    android:id="@+id/zoneMarchingBorder"
                    android:layout_width="0dp"
                    android:layout_height="0dp" />
            </FrameLayout>
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnMode"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:minWidth="0dp"
            android:paddingHorizontal="18dp"
            android:background="@drawable/bg_pill_button"
            android:text="@string/mode_button"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnConnect"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="10dp"
            android:minWidth="0dp"
            android:paddingHorizontal="16dp"
            android:background="@drawable/bg_pill_button"
            android:text="@string/scan_connect"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/scanStatusText"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Body: color-picking on the left, glanceable preview + sliders on
         the right - each scrolls on its own. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ScrollView
            android:id="@+id/mainScrollView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/mainContentColumn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:id="@+id/colorCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="16dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="16dp">

                    <com.ledcar01.controller.HsvColorWheelView
                        android:id="@+id/colorWheel"
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvRgbReadout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_pill_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="R 255  G 80  B 80"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        style="@style/SectionLabel"
                        android:layout_gravity="center_horizontal"
                        android:text="@string/label_default_colors" />

                    <LinearLayout
                        android:id="@+id/defaultColorsRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="14dp"
                        android:gravity="center"
                        android:orientation="horizontal" />

                    <TextView
                        style="@style/SectionLabel"
                        android:layout_gravity="center_horizontal"
                        android:text="@string/label_saved_colors" />

                    <LinearLayout
                        android:id="@+id/savedColorsRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnSaveColor"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_pill_button"
                            android:minWidth="0dp"
                            android:paddingHorizontal="14dp"
                            android:text="@string/save_button"
                            android:textAllCaps="false"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />

                        <HorizontalScrollView
                            android:id="@+id/savedEggsScroll"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:scrollbars="none">

                            <LinearLayout
                                android:id="@+id/savedEggsRow"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.9"
            android:orientation="vertical">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/ambientPreviewCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_margin="16dp"
                    android:layout_marginBottom="8dp">

                    <FrameLayout
                        android:id="@+id/ambientPreviewFrame"
                        android:layout_width="match_parent"
                        android:layout_height="180dp">

                        <ImageView
                            android:id="@+id/imgBaseInterior"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="14dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/base_interior" />

                        <ImageView
                            android:id="@+id/imgFootwellLight"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="14dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/mask_footwell_glow" />

                        <ImageView
                            android:id="@+id/imgNeonStripLight"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="14dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/mask_neon_strips" />
                    </FrameLayout>
                </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:id="@+id/bottomBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_margin="16dp"
                android:layout_marginTop="0dp">

                <LinearLayout
                    android:id="@+id/brightnessLabelRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <TextView
                        style="@style/SectionLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginBottom="0dp"
                        android:text="@string/label_brightness" />

                    <TextView
                        android:id="@+id/tvBrightnessValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="80%"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </LinearLayout>
                <SeekBar
                    android:id="@+id/seekBrightness"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="80"
                    android:progressTint="@color/accent"
                    android:thumbTint="@color/accent"
                    android:layout_marginBottom="14dp" />

                <LinearLayout
                    android:id="@+id/speedLabelRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <TextView
                        style="@style/SectionLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginBottom="0dp"
                        android:text="@string/label_speed" />

                    <TextView
                        android:id="@+id/tvSpeedValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="50%"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </LinearLayout>
                <SeekBar
                    android:id="@+id/seekSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="50"
                    android:progressTint="@color/accent"
                    android:thumbTint="@color/accent" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
