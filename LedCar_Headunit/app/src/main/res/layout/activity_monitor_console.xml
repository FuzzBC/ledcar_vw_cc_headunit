<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_dialog_header_settings"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/monitor_console_title"
            android:textColor="@color/dialog_header_text"
            android:textSize="17sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnMonitorClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:background="@drawable/bg_pill_button"
            android:text="✕"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Add a custom action string to watch, e.g. one found by decompiling
         a head unit's launcher APK - see BroadcastMonitorService's class
         doc. Takes effect immediately, no restart needed. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/editCustomAction"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_button"
            android:hint="e.g. com.junsun.action.DAY_NIGHT"
            android:textColorHint="@color/text_secondary"
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:inputType="text"
            android:maxLines="1" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnWatchAction"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:paddingHorizontal="16dp"
            android:background="@drawable/bg_outline_save"
            android:text="Watch"
            android:textAllCaps="false"
            android:textColor="@color/btn_save_color"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvWatchedActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingBottom="8dp"
        android:text=""
        android:textColor="@color/text_secondary"
        android:textSize="10sp" />

    <ListView
        android:id="@+id/listMonitorEntries"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/border"
        android:dividerHeight="1dp"
        android:paddingHorizontal="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnClearLog"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_outline_settings"
            android:text="Clear log"
            android:textAllCaps="false"
            android:textColor="@color/btn_settings_color"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
