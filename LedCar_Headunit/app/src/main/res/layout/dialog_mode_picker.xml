<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/modePickerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvModePickerTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_header_mode"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp"
        android:text="@string/mode_button"
        android:textColor="@color/dialog_header_text"
        android:textSize="17sp" />

    <LinearLayout
        android:id="@+id/modePickerBody"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_dialog_body_mode"
        android:padding="10dp">

        <LinearLayout
            android:id="@+id/modePickerTabRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/tabRgb"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_pill_button_accent"
                android:text="RGB"
                android:textAllCaps="false"
                android:textColor="@color/bg_page"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/tabDmx"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:background="@drawable/bg_outline_settings"
                android:text="DMX"
                android:textAllCaps="false"
                android:textColor="@color/btn_settings_color"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/modePickerListCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_mode_list_card"
            android:padding="4dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/effectRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="vertical"
                android:fadeScrollbars="false"
                android:scrollbarStyle="outsideOverlay" />
        </FrameLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnStaticColor"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_outline_danger"
            android:text="Cancel mode - static color"
            android:textAllCaps="false"
            android:textColor="@color/btn_danger_color"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
